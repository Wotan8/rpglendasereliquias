{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "graphify-out/**",
      "sistema antigo e lore/**",
      "**/__check-*",
      "**/__previa.html",
      "**/*.test.mjs",
      "BRIEFING.md",
      "temp_path.txt",
      "*.rules"
    ],
    "redirects": [
      {
        "//": "O Portal saiu de /menu/menu.html para a raiz. 301 permanente para tudo que ficou apontando para o endereço antigo: favoritos, páginas em cache e links antigos de retorno de pagamento.",
        "source": "/menu/menu.html",
        "destination": "/",
        "type": 301
      },
      { "source": "/menu", "destination": "/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Content-Type", "value": "text/css; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=60" }
        ]
      },
      {
        "//": "HTML vem DEPOIS do ** de propósito: quando duas regras casam o mesmo arquivo, a última vence. E o HTML não pode ficar preso em cache — com max-age=3600 uma correção publicada demorava até uma hora para chegar em quem já tinha aberto o site. 'no-cache' não proíbe guardar: obriga a revalidar antes de usar, e o servidor responde 304 quando nada mudou. Os .js e .css seguem cacheados porque são versionados por ?v=.",
        "source": "**/*.html",
        "headers": [
          { "key": "Content-Type", "value": "text/html; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "//": "A raiz é servida por rewrite para /index.html, mas o header casa pelo caminho PEDIDO — e '/' não casa com **/*.html.",
        "source": "/",
        "headers": [
          { "key": "Content-Type", "value": "text/html; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
          { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*firebase-adminsdk*.json",
        "__*.mjs",
        "_backup-*.json",
        "avulsos-imagens",
        "*.md"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
