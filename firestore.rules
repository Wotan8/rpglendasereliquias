rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/masters/$(request.auth.uid));
    }

    /* O papel vem do TOKEN quando existe, e do documento quando não.

       O token é a fonte melhor: chega assinado pelo Firebase Auth, não custa
       leitura de documento, e não depende de `users` continuar legível — se um
       dia essa regra apertar, o cargo para de funcionar junto, sem aviso.

       O documento fica como reserva porque a claim só aparece no token DEPOIS
       de o usuário renovar a sessão. Sem a reserva, o dia da virada seria um
       dia de mestre trancado para fora do painel. Quando todo mundo tiver
       claim, esta metade vira peso morto inofensivo.

       `definirCargo` grava os dois e revoga a sessão — ver o comentário lá. */
    function papelNoToken() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function papelNoDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function papel() {
      return papelNoToken() != '' ? papelNoToken() : papelNoDoc();
    }

    function isCriador() {
      return isSignedIn() && papel() == 'criador';
    }

    /* Papel de Mestre — é assim que painel-mestre/js/auth.js decide quem entra
       no painel. `isMaster()` acima é outra coisa: olha a coleção `masters`,
       que nem todo mestre tem. */
    function temPapelMestre() {
      return isSignedIn() && papel() in ['mestre', 'criador'];
    }

    /* Campos que só o servidor (Cloud Functions) e mestres podem alterar.
       `giros` e `rerolagens` entram aqui pelo mesmo motivo de `fragmentos`: são
       saldo, e saldo que o navegador consegue escrever é saldo infinito.

       `role` entra pelo motivo mais direto de todos: era o que decidia quem
       abre o Painel do Mestre e do Criador, quem escreve o catálogo inteiro em
       `system/data/*` e quem o servidor aceita como mestre — e o dono do
       documento podia escrevê-lo. Cargo agora só muda por `definirCargo`
       (Cloud Function, Admin SDK). O jogador PEDE por `cargoSolicitado`, que
       continua livre e não vale nada sozinho. */
    function CAMPOS_PROTEGIDOS() {
      return ['fragmentos', 'inventario', 'apoios', 'logsCompra', 'fragLastOp',
              'giros', 'rerolagens', 'role'];
    }

    function naoMexeuEmCamposProtegidos() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(CAMPOS_PROTEGIDOS());
    }

    /* `uid` e `email` no documento são IDENTIDADE, não dado comum. Servidor e
       cliente já acharam o jogador consultando esses campos (`where('uid','==')`,
       depois `where('email','==')`), e os dois eram graváveis pelo dono: quem
       escrevesse `uid: <uid de outra pessoa>` no próprio documento passava a
       receber o que fosse resolvido para ela — inclusive a entrega de uma
       compra em dinheiro real.

       A busca por campo já saiu do código (hoje é sempre `users/{uid}`), e
       estas duas funções fecham a porta pelo outro lado: no `create` os campos
       só podem repetir a identidade do próprio token; no `update` não mudam
       mais. */
    function identidadeCorreta(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
    }

    /* `uid` nunca muda. `email` pode — mas só para o do próprio token, que é o
       que o Firebase Auth confirmou. Isso libera a troca de e-mail nas
       Configurações (o documento acompanha o Auth no login seguinte) sem
       reabrir o buraco do item 2: continua sendo impossível apontar o próprio
       documento para o endereço de outra pessoa. */
    function naoMexeuNaIdentidade() {
      let mexeu = request.resource.data.diff(resource.data).affectedKeys();
      return !mexeu.hasAny(['uid'])
        && (!mexeu.hasAny(['email']) || request.resource.data.email == request.auth.token.email);
    }

    // ========== Coleções do Painel de Criador (system/data/*) ==========
    match /system/data/{collection}/{document} {
      allow read: if isSignedIn();
      allow write: if isCriador();
    }

    /* Fresta para o Mestre mandar peça nova ao catálogo de Equipamentos.
       Ele CRIA como rascunho (publicado: false) e só isso: não edita nem apaga
       o que já existe, e não publica. A peça aparece no Painel do Criador com o
       selo "Rasc" e some de todo picker até alguém publicar — o filtro
       `publicado !== false` já é o que os painéis usam. */
    match /system/data/equipment/{document} {
      allow read: if isSignedIn();
      allow create: if isCriador() ||
        (temPapelMestre() && request.resource.data.publicado == false);
      allow update, delete: if isCriador();
    }

    // Coleção de mestres (sem alterações)
    match /masters/{uid} {
      allow read: if isMaster();
      allow write: if false;
    }

    /* Coleção de usuários (TRANCADA — Frag$/inventário só via Cloud Function
       ou mestre).

       A LEITURA era aberta a qualquer conta logada: uma consulta trazia o
       e-mail, o saldo de Frag$, o Repertório inteiro, o histórico de compras em
       reais e as notificações de todo mundo. Agora cada um lê o próprio
       documento; mestre e criador leem todos, que é o que os painéis fazem.
       O que jogador precisa saber dos outros mora em `users_public`. */
    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isMaster() || temPapelMestre());

      // Criação do próprio doc: não pode nascer com saldo/inventário — nem com
      // cargo. Conta nova é jogador; `role` ausente já é isso em todo o site.
      allow create: if isSignedIn() && (
        isMaster() ||
        (request.auth.uid == userId &&
         !request.resource.data.keys().hasAny(CAMPOS_PROTEGIDOS()) &&
         identidadeCorreta(userId))
      );

      // Mestre mantém escrita total (painel-mestre concede Frag$ e apoios pelo cliente)
      allow update: if isSignedIn() && (
        isMaster() ||
        (request.auth.uid == userId &&
         naoMexeuEmCamposProtegidos() &&
         naoMexeuNaIdentidade())
      );

      allow delete: if isMaster();
    }

    /* Espelho público do jogador: nome de exibição e apoios sem valor em reais.
       Escrito SÓ pelo gatilho `espelharUsuarioPublico`. É o que sustenta a soma
       coletiva das Metas e os nomes na mesa do Tabuleiro sem abrir `users`. */
    match /users_public/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* Cada link de redefinição de senha gerado por um Criador: para quem, por
       quem, e quais contatos estavam cadastrados na hora. Escrita SÓ pelo
       servidor. É a operação mais sensível do sistema — quem recupera uma
       conta, entra nela —, então não existe versão dela sem trilha.
       Leitura só do Criador: a lista revela quem já precisou de recuperação. */
    match /recuperacao_logs/{logId} {
      allow read: if isCriador();
      allow create, update, delete: if false;
    }

    /* Contadores do freio por usuário (limitarChamadas). Só o servidor mexe —
       e ninguém precisa ler: contador que o navegador enxerga é contador que
       o navegador aprende a driblar. */
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // Auditoria de Fragmentos — escrita SOMENTE pelo servidor (Admin SDK ignora rules)
    match /frag_logs/{logId} {
      // Mestres veem tudo; jogador pode ver os logs da própria conta
      allow read: if isSignedIn() && (isMaster() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* Quem virou mestre ou criador, por decisão de quem e quando — escrita
       SOMENTE pelo servidor (definirCargo). Cargo é a chave do cofre: mudança
       de cargo sem trilha é mudança que ninguém consegue contestar depois. */
    match /cargo_logs/{logId} {
      allow read: if isCriador() || isMaster();
      allow create, update, delete: if false;
    }

    // Auditoria de transações em dinheiro real (Mercado Pago) — escrita SOMENTE pelo servidor
    match /real_logs/{logId} {
      allow read: if isSignedIn() && (isMaster() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* Fila de avisos para o mestre. Criada SÓ pelo servidor: aviso que o
       navegador cria é aviso que o navegador forja.
       A leitura aceita os DOIS jeitos de ser mestre porque o painel entra pelo
       `role` em users e as rules olham a coleção `masters` — hoje 2 dos 3
       mestres não têm doc em `masters` e não veriam aviso nenhum.
       O update existe para marcar como lido; o delete não, para ninguém
       apagar o que não quis resolver. */
    match /avisos_mestre/{avisoId} {
      allow read, update: if isSignedIn() && (isMaster() || temPapelMestre());
      allow create, delete: if false;
    }

    // Cada aplicação de EXP do Repertório numa ficha — escrita SOMENTE pelo
    // servidor. EXP é comprado com dinheiro; tem de dar para reconstruir quem
    // aplicou o quê, em quem e quando.
    match /exp_logs/{logId} {
      allow read: if isSignedIn() && (isMaster() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Cada giro da roleta, com o que saiu e o saldo antes/depois — escrita
    // SOMENTE pelo servidor. É a prova de que o sorteio não foi no navegador.
    match /roleta_logs/{logId} {
      allow read: if isSignedIn() && (isMaster() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Cada re-rolagem gasta na mesa, com o saldo antes/depois — escrita SOMENTE
    // pelo servidor. É o que permite conferir uma re-rolagem contestada.
    match /rerolagem_logs/{logId} {
      allow read: if isSignedIn() && (isMaster() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Compras pendentes (Mercado Pago) — criadas/atualizadas SOMENTE pelas Cloud Functions.
    // O jogador só lê as próprias compras; mestre lê todas; ninguém escreve pelo cliente.
    match /compras_pendentes/{compraId} {
      allow read: if isSignedIn() && (isMaster() || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Coleção de personagens (CORRIGIDA)
    match /characters/{characterId} {
      // ✅ Leitura: QUALQUER usuário autenticado pode ver todos os personagens
      // (necessário para rankings públicos)
      allow read: if isSignedIn();

      // ✅ Criação: usuário define ele mesmo como dono OU mestre pode criar para qualquer jogador
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid || isMaster()
      );

      // ✅ CORREÇÃO DO BUG: Atualização precisa garantir que ownerUid não mude
      allow update: if isSignedIn() && (
        (resource.data.ownerUid == request.auth.uid && 
         request.resource.data.ownerUid == resource.data.ownerUid) || 
        isMaster()
      );
      
      // ✅ Exclusão: dono OU mestre
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isMaster()
      );
    }

    /* O prefixo `__` é namespace do SERVIDOR: `__caixa_mestre__<mesaId>` é o
       dono virtual da Caixa do Mestre, e não é personagem de ninguém.

       Sem esta trava, o ID do documento era escolha livre de quem cria: o
       jogador criava `char/__caixa_mestre__<mesaId>` com `ownerUid` dele e
       virava, para as rules de `items`, o "dono do personagem" de TODA peça na
       caixa daquela mesa — inclusive as dos outros. Daí editava a própria peça
       e pedia a recusa. */
    function idReservado(charId) {
      return charId.matches('__.*');
    }

    // ========== ADICIONADO: Coleção 'char' (ficha-v1.7_1) ==========
    match /char/{charId} {
      // Leitura: qualquer usuário autenticado (para listagens e rankings)
      allow read: if isSignedIn();

      // Criação: usuário define ele mesmo como dono OU mestre
      allow create: if isSignedIn() && !idReservado(charId) && (
        request.resource.data.ownerUid == request.auth.uid || isMaster()
      );

      /* Atualização: dono (sem mudar ownerUid) OU mestre.
         `temPapelMestre()` ao lado de `isMaster()` pelo motivo de sempre: HÁ
         DOIS JEITOS DE SER MESTRE aqui, e eles não coincidem — dois dos três
         mestres não têm doc na coleção `masters`. Para eles, o painel abria e
         a escrita era negada, sem nada na tela explicando. É o que faz o
         "+Avulso" (que grava `mesaId` na ficha) funcionar para todos. */
      allow update: if isSignedIn() && (
        (resource.data.ownerUid == request.auth.uid && 
         request.resource.data.ownerUid == resource.data.ownerUid) || 
        isMaster() || temPapelMestre()
      );
      
      // Exclusão: dono OU mestre
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isMaster() || temPapelMestre()
      );
    }

    /* Trilha de auditoria. O create é aberto porque quem escreve é o JOGADOR:
       a ficha registra cada mudança que ele faz (char-logger.js), e o painel do
       mestre registra as dele. 5.525 documentos, de 6 pessoas diferentes.

       O que faltava era qualquer conferência. Dava para gravar log em nome de
       outra pessoa — numa coleção que só o mestre lê, e que existe justamente
       para dizer quem fez o quê — e para despejar documento de tamanho
       arbitrário.

       `user` agora tem de ser o e-mail do próprio token: log de auditoria que
       aceita autor forjado não é auditoria. */
    function logBemFormado() {
      return request.resource.data.user == request.auth.token.email
        && request.resource.data.keys().size() <= 24
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 1000
        && request.resource.data.timestamp is string;
    }

    match /logs/{logId} {
      allow create: if isSignedIn() && logBemFormado();
      // Os dois caminhos de ser mestre: sem o segundo, 2 dos 3 não leem a
      // própria trilha.
      allow read: if isMaster() || temPapelMestre();
      allow update, delete: if false;
    }
    
    /* O que a MESA move num NPC durante o jogo, e mais nada: vida/energia/
       sanidade atuais (tudo dentro de `valoresDer.atual`) e as condições.
       É o que o Tabuleiro grava quando um jogador acerta um golpe — por isso
       não pode exigir mestre.

       Vinha `allow update: if isSignedIn()`, sem recorte: qualquer conta
       logada reescrevia QUALQUER NPC do cenário inteiro — nome, atributos,
       ataques, loot e a história dele. Não era preciso nem estar na mesa.

       A conferência de campo vem PRIMEIRO no `||` de propósito: ela é de
       graça, e é o caminho do jogador em combate. Só a edição completa, que é
       do mestre, paga o exists()/get(). */
    function soEstadoDeMesaNoNpc() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['valoresDer', 'conditions', 'lastUpdate', 'lastUpdateBy']);
    }

    /* Os "Personagens Importantes" da Fase 6 do Criar Personagem (Os Laços).
       O jogador pode criá-los — mas só dentro de uma cerca fechada:

       - a ficha vinculada tem de ser DELE;
       - o NPC tem de nascer preso a uma MESA em que ele joga, porque é ali
         que existe um mestre responsável pelo que entra no mundo;
       - e marcado como vindo do assistente, para o painel saber a origem.

       Personagem avulso não cria NPC nenhum (o assistente nem tenta): os laços
       dele ficam nas Notas da ficha. É o que impede qualquer conta de despejar
       personagem no cadastro do cenário.

       Antes disto o `create` era só de mestre, e o assistente tentava assim
       mesmo — falhando em silêncio desde sempre. */
    function npcDeLacoDoJogador() {
      return request.resource.data.createdVia == 'wizard-v1'
        && request.resource.data.mesaId is string
        && request.resource.data.mesaId != ''
        && request.auth.uid in
             get(/databases/$(database)/documents/mesas/$(request.resource.data.mesaId)).data.jogadores
        && request.resource.data.linkedCharId is string
        && get(/databases/$(database)/documents/char/$(request.resource.data.linkedCharId))
             .data.ownerUid == request.auth.uid;
    }

    // ========== ADICIONADO: Coleção de NPCs ==========
    match /npcs/{npcId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        (soEstadoDeMesaNoNpc() || isMaster() || temPapelMestre());
      allow create: if isMaster() || (isSignedIn() && npcDeLacoDoJogador());
      allow delete: if isMaster();
    }
    
    // ========== CORRIGIDO: Coleção de Containers ==========
    match /containers/{containerId} {
      // ✅ Permitir leitura/query para usuários autenticados
      allow read: if isSignedIn();

      // ✅ Criação: dono OU mestre pode criar
      allow create: if isSignedIn() && 
        (request.resource.data.ownerId == request.auth.uid || request.resource.data.ownerUid == request.auth.uid || isMaster());

      // ✅ Atualização: dono do container, dono do personagem vinculado, OU mestre
      allow update: if isSignedIn() && (
        // Dono do container pode atualizar (mantendo o mesmo ownerId/ownerUid)
        (resource.data.ownerId == request.auth.uid && 
         request.resource.data.ownerId == resource.data.ownerId) ||
        (resource.data.ownerUid == request.auth.uid && 
         request.resource.data.ownerUid == resource.data.ownerUid) ||
        // Dono do personagem vinculado pode atualizar (verificando via characterId)
        (exists(/databases/$(database)/documents/char/$(resource.data.characterId)) &&
         get(/databases/$(database)/documents/char/$(resource.data.characterId)).data.ownerUid == request.auth.uid) ||
        // Mestre pode sempre atualizar
        isMaster()
      );
      
      // ✅ Exclusão: dono do container, dono do personagem, OU mestre
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        (exists(/databases/$(database)/documents/char/$(resource.data.characterId)) &&
         get(/databases/$(database)/documents/char/$(resource.data.characterId)).data.ownerUid == request.auth.uid) ||
        isMaster()
      );
    }
    
    /* Peça que está na Caixa do Mestre. O jogador manda para lá pelo servidor
       (enviarItemParaMesa) e ela só sai por decisão do mestre — recusando o
       aviso ou transferindo para alguém. Enquanto está na caixa, o navegador
       não escreve nela. */
    /* Dono de NPC aliado. `donosUids` é espelho de `vinculos` — a lista
       `{tipo:'personagem', id:<charId>}` resolvida para o uid do dono de cada
       ficha, mantida pelo gatilho `espelharDonoDoNpc`. Rules não conseguem
       varrer lista de objetos procurando um `tipo`; conseguem um `in`. */
    function ehDonoDoNpcAliado() {
      return exists(/databases/$(database)/documents/npcs/$(resource.data.characterId)) &&
        request.auth.uid in
          get(/databases/$(database)/documents/npcs/$(resource.data.characterId))
            .data.get('donosUids', []);
    }

    function naCaixaDoMestre() {
      return resource.data.characterId is string &&
             resource.data.characterId.matches('__caixa_mestre__.*');
    }

    // ========== CORRIGIDO: Coleção de Itens ==========
    match /items/{itemId} {
      // ✅ Permitir leitura/query para usuários autenticados
      allow read: if isSignedIn();

      // ✅ Criação: dono OU mestre pode criar
      allow create: if isSignedIn() && 
        (request.resource.data.ownerId == request.auth.uid || request.resource.data.ownerUid == request.auth.uid || isMaster());

      // ✅ Atualização: dono do item, dono do personagem vinculado, OU mestre
      allow update: if isSignedIn() && (
        // Dono do item pode atualizar (mantendo o mesmo ownerId/ownerUid)
        (resource.data.ownerId == request.auth.uid && 
         request.resource.data.ownerId == resource.data.ownerId) ||
        (resource.data.ownerUid == request.auth.uid && 
         request.resource.data.ownerUid == resource.data.ownerUid) ||
        // Dono do personagem vinculado pode atualizar (verificando via characterId).
        // `!naCaixaDoMestre()`: peça na caixa é do mestre até ele decidir onde
        // ela entra no mundo — e era por aqui que o jogador voltava a mexer nela.
        (!naCaixaDoMestre() &&
         exists(/databases/$(database)/documents/char/$(resource.data.characterId)) &&
         get(/databases/$(database)/documents/char/$(resource.data.characterId)).data.ownerUid == request.auth.uid) ||
        // Item de NPC ALIADO: só quem é dono da ficha vinculada ao NPC.
        // Era `exists(npcs/<characterId>)` — a mera existência do NPC bastava,
        // o que dava a qualquer conta logada poder sobre item de qualquer NPC
        // do cenário. `donosUids` é o vínculo `{tipo:'personagem'}` achatado
        // pelo gatilho `espelharDonoDoNpc`.
        ehDonoDoNpcAliado() ||
        // Mestre pode sempre atualizar (pelos dois caminhos de ser mestre)
        isMaster() || temPapelMestre()
      );
      
      // ✅ Exclusão: dono do item, dono do personagem, OU mestre
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        (!naCaixaDoMestre() &&
         exists(/databases/$(database)/documents/char/$(resource.data.characterId)) &&
         get(/databases/$(database)/documents/char/$(resource.data.characterId)).data.ownerUid == request.auth.uid) ||
        // Item de NPC aliado: só o dono da ficha vinculada (ver acima)
        ehDonoDoNpcAliado() ||
        isMaster() || temPapelMestre()
      );
    }

    // ========== ADICIONADO: Coleções de Economia ==========
    match /economy-items/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /economy-locations/{locationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /economy-events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção de Coisas da Economia ==========
    match /economy-coisas/{coisaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção de Hexmaps ==========
    match /hexmaps/{mapId} {
      allow read: if isMaster();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Configurações do Hexmap (mapa padrão) ==========
    match /hexmap-settings/{settingId} {
      allow read: if isMaster();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção de Configurações (Metas antigas e Lista de Produção) ==========
    match /config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção de Metas Dinâmicas ==========
    match /metas/{metaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção da Loja (Itens de Repertório) ==========
    match /loja_itens/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Configurações Globais (Ex: Favicons) ==========
    match /app-config/{docId} {
      allow read: if true;
      allow write: if isCriador();
    }

    // ========== ADICIONADO: Coleção de Configurações do Mestre ==========
    match /mestre-config/{docId} {
      allow read: if isMaster();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleções de Worldbuilding ==========
    match /worldbuilding-geography/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-factions/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-history/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-cultures/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-magic/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-religion/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção de Propriedades do Worldbuilding ==========
    match /worldbuilding-properties/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // Arestas dos Grafos de Conexão (genealogia + teia de facções)
    match /worldbuilding-relations/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // Linhagens familiares (⚜️ Casas / Clãs) — NOVA
    match /worldbuilding-lineages/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // Textos do Escritório do Cronista (contos e descrições)
    match /worldbuilding-articles/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-books/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // Config do Portal (hero de imagens etc.) — leitura pública: o hero
    // aparece antes do login. Só o Criador escreve.
    match /portal-config/{docId} {
      allow read: if true;
      allow write: if isCriador();
    }

    // ========== ADICIONADO: Coleções de Session Logs ==========
    match /campaigns/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /session-logs/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Configurações do Worldbuilding (campanha favorita) ==========
    match /worldbuilding-settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /notifications/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== ADICIONADO: Coleção de Mesas (Campanhas) ==========
    match /mesas/{mesaId} {
      allow read: if isSignedIn();
      /* Idem: os dois jeitos de ser mestre. O "+Avulso" põe o dono do
         personagem em `mesas.jogadores`, e sem isto só o mestre que tem doc em
         `masters` conseguiria. */
      allow create, update, delete: if isMaster() || temPapelMestre();

      // ===== Subcoleções do Tabuleiro (VTT) — FASE 7.1 =====
      // Leitura: qualquer usuário autenticado (o modo público filtra a visibilidade no cliente).
      //
      // LIMITAÇÃO HONESTA: as permissões finas por ferramenta (desenhar, medir, mover
      // token específico...) vivem no doc do canvas e mudam com frequência; espelhá-las
      // 1:1 nas rules exigiria múltiplos get() por write (custo e latência). O modelo
      // adotado: jogador vinculado à mesa pode escrever nas subcoleções do tabuleiro,
      // mas NÃO pode alterar a configuração dos canvases (grid, permissões, camadas,
      // fog) — apenas o campo de exploração compartilhada.
      function ehJogadorDaMesa() {
        return isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.jogadores;
      }

      // Doc do canvas: só o mestre configura; jogadores só atualizam a exploração (fog persistente)
      match /tabuleiros/{canvasId} {
        allow read: if isSignedIn();
        allow create, delete: if isMaster();
        allow update: if isMaster() ||
          (ehJogadorDaMesa() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exploracao']));

        // Objetos do canvas: mestre ou jogador da mesa (regras finas no cliente)
        match /objetos/{objId} {
          allow read: if isSignedIn();
          allow write: if isMaster() || ehJogadorDaMesa();
        }

        // 💬 Chat do canvas: mensagens e diário de acontecimentos.
        // Só criação (histórico não se edita); apagar é faxina do mestre.
        match /chat/{msgId} {
          allow read: if isSignedIn();
          allow create: if isMaster() || ehJogadorDaMesa();
          allow delete: if isMaster();
        }
      }

      // Presença (cursores ao vivo): um doc POR USUÁRIO — cada um só escreve o próprio
      match /presenca/{uid} {
        allow read: if isSignedIn();
        allow write: if isMaster() || (ehJogadorDaMesa() && request.auth.uid == uid);
      }

      // Réguas compartilhadas: mesma divisão — um doc por usuário
      match /reguas/{uid} {
        allow read: if isSignedIn();
        allow write: if isMaster() || (ehJogadorDaMesa() && request.auth.uid == uid);
      }

      // Metadados ao vivo: estado/combate/réguas/pings/legenda/musica
      match /tabuleiro-meta/{docId} {
        allow read: if isSignedIn();
        // legenda (teleprompter), estado (canvas ativo) e musica (playlists) são só do mestre
        allow write: if isMaster() ||
          (ehJogadorDaMesa() && docId != 'legenda' && docId != 'estado' && docId != 'musica');
      }

      // Frentes e Sessões — segredo de mestre: presságios, segredos e preparo
      // não podem nem ser LIDOS por jogadores. Matches sobrepostos são OR no
      // Firestore, então o catch-all abaixo também precisa excluí-los.
      match /frentes/{frenteId} {
        allow read, write: if isMaster();
      }
      match /sessoes/{sessaoId} {
        allow read, write: if isMaster();
      }

      // Demais subcoleções futuras da mesa (exceto as só-do-mestre acima)
      match /{sub}/{document=**} {
        allow read: if isSignedIn() && sub != 'frentes' && sub != 'sessoes';
        allow write: if (isMaster() || ehJogadorDaMesa()) && sub != 'frentes' && sub != 'sessoes';
      }
    }

    // ========== ADICIONADO: Coleções do Submundo ==========
    match /worldbuilding-submundo-feiras/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-submundo-reputacoes/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    match /worldbuilding-rumors/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }
  }
}
