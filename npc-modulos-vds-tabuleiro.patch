+export function normalizeClassModule(mod) {
+    if (!mod || typeof mod !== 'object') return null;
+    return {
+        ...mod,
+        id: mod.id || ('mod_' + String(mod.titulo || '').toLowerCase().replace(/[^a-z0-9]/g, '_')),
