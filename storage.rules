rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ViewMap tiles - authenticated users can read/write
    match /viewmap-tiles/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Hexmap terrain images - authenticated users can read/write
    match /hexmap-terrain/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Character images - authenticated users can read/write
    match /char-images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Favicons - public read, authenticated users can write (UI blocks non-creators)
    match /app-assets/favicons/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

